---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} – Stefan Ilić`} description={post.data.description}>
  <article class="band prose">
    <p style="color:var(--muted);margin:0"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>
    <h1>{post.data.title}</h1>
    <Content />
    <p><a href="/blog/">← All posts</a></p>
  </article>
</Base>
